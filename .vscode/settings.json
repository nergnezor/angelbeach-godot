{
  // Godot Tools' own setting, and the single source of truth for the engine
  // path: the launch configs and tasks below read it back with
  // ${config:godotTools.editorPath.godot4}. It used to be a private
  // "angelbeach.godot" key, which meant two places to change and a variable
  // VS Code only resolves for settings some extension actually contributes.
  "godotTools.editorPath.godot4": "/home/erik/godot4/Godot_v4.7.1-stable_linux.x86_64",
  // Godot's language server lives inside an editor process, so without this
  // Godot Tools just retries 127.0.0.1:6005 forever and nags. Headless mode
  // makes the extension start its own `--editor --headless --no-window
  // --lsp-port <free port>` child instead, so GDScript completion,
  // go-to-definition and errors work with no editor window open.
  // It picks the port itself; pinning lsp.serverPort here does nothing but
  // put a wrong number in the error messages.
  "godotTools.lsp.headless": true,

  "rust-analyzer.linkedProjects": ["${workspaceFolder}/rust/Cargo.toml"],
  "files.associations": {
    "*.gdextension": "ini",
    "*.tscn": "ini",
    "*.tres": "ini"
  },
  "files.exclude": {
    "rust/target": true,
    ".godot": true
  }
}
