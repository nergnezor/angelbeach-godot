{
  // type: "lldb" is CodeLLDB (vadimcn.vscode-lldb), which launches a native
  // binary directly. Do NOT use type: "node" here — js-debug expects a Node
  // program, and handed a Godot binary it fails without a useful message.
  // As a side benefit this is a real native debugger, so breakpoints in
  // rust/src/lib.rs work while the game runs.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play (windowed)",
      "type": "lldb",
      "request": "launch",
      "program": "${config:angelbeach.godot}",
      "args": ["--path", "${workspaceFolder}", "res://src/match/Match.tscn"],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "sourceLanguages": ["rust"],
      "preLaunchTask": "cargo build"
    },
    {
      "name": "Headless match (the acceptance run)",
      "type": "lldb",
      "request": "launch",
      "program": "${config:angelbeach.godot}",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "res://src/match/Match.tscn"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "sourceLanguages": ["rust"],
      "preLaunchTask": "cargo build"
    },
    {
      "name": "Screenshot (writes a PNG, then quits)",
      "type": "lldb",
      "request": "launch",
      "program": "${config:angelbeach.godot}",
      "args": [
        "--path",
        "${workspaceFolder}",
        "res://src/debug/Shot.tscn",
        "--",
        "420"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "preLaunchTask": "cargo build"
    },
    {
      "name": "Spike 1 — movement budget PORTCHECK",
      "type": "lldb",
      "request": "launch",
      "program": "${config:angelbeach.godot}",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "res://src/debug/Spike1.tscn"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "sourceLanguages": ["rust"],
      "preLaunchTask": "cargo build"
    },
    {
      "name": "Spike 3 — foot lock vs skate",
      "type": "lldb",
      "request": "launch",
      "program": "${config:angelbeach.godot}",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "res://src/debug/Spike3.tscn"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated"
    },
    {
      "name": "Diag — rig scale and contact profile",
      "type": "lldb",
      "request": "launch",
      "program": "${config:angelbeach.godot}",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "res://src/debug/Diag.tscn"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated"
    },
    {
      "name": "Editor",
      "type": "lldb",
      "request": "launch",
      "program": "${config:angelbeach.godot}",
      "args": ["--editor", "--path", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "preLaunchTask": "cargo build"
    }
  ]
}
