[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libangelbeach.debug.so"
linux.release.x86_64 = "res://bin/libangelbeach.release.so"
; Web. Built for wasm32-unknown-emscripten and staged the same way as the
; native libs. The Emscripten version MUST match the one Godot's own web
; templates were built with, or the module fails to link against them.
;
; The `.threads.` key, not the plain `web.debug.wasm32` one: our export
; preset forces variant/thread_support=true, so Godot's threaded web runtime
; looks specifically for the .threads. key to find a thread-compatible side
; module. The plain key is for the non-threaded (experimental-wasm-nothreads)
; variant, which this project does not build -- pointing a threaded .wasm at
; the plain key was silent (Godot found A file, just not through the lookup
; its own threaded runtime uses) and was one layer of the memory-mismatch
; LinkError seen at load, on top of the crate itself lacking +atomics.
web.debug.threads.wasm32 = "res://bin/libangelbeach.wasm32.debug.wasm"
web.release.threads.wasm32 = "res://bin/libangelbeach.wasm32.release.wasm"
; Android. arm64-v8a only — every Vulkan phone is 64-bit, and shipping a
; 32-bit .so would double the NDK work for a device class Godot itself no
; longer defaults on. Built with the NDK clang wrapper (see build.sh
; --android); the filename still starts with lib, which Android's apk packer
; requires (EditorExportPlatformAndroid::save_apk_so).
android.debug.arm64 = "res://bin/libangelbeach.android.arm64.debug.so"
android.release.arm64 = "res://bin/libangelbeach.android.arm64.release.so"
